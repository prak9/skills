-
+
-async function saveProvision(candidate: Provision, store: Store) {
+async function saveProvision(candidate: Provision, store: Store, preview: boolean) {
+  if (preview) {
+    return candidate;
+  }
   return store.create(candidate);
 }
-
+
-async function writeAudit(resource: Provision, audit: AuditLog) {
+async function writeAudit(resource: Provision, audit: AuditLog, preview: boolean) {
+  if (preview) {
+    return;
+  }
   await audit.record("provisioned", resource);
 }
-
+
-async function sendNotice(resource: Provision, notifier: Notifier) {
+async function sendNotice(resource: Provision, notifier: Notifier, preview: boolean) {
